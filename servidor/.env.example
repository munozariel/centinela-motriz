# Copiar como .env y completar. El .env NO se sube a git.
# Generar claves con:  openssl rand -hex 24
# Guardar una copia en un gestor de contraseñas antes del primer arranque.

DOMINIO=ejemplo.com
DATA_DIR=/srv/apps/monitor/data
# Para probar en la PC:
# DATA_DIR=./data-local
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# Versiones exactas de las imágenes, probadas en noviembre de 2026 (no usar latest)
N8N_VERSION=2.46.6
GRAFANA_VERSION=13.0.2

POSTGRES_PASSWORD=cambiar
N8N_DB_PASSWORD=cambiar
MONITOR_DB_PASSWORD=cambiar
GRAFANA_DB_PASSWORD=cambiar

# Clave con la que n8n cifra las credenciales guardadas. Si se pierde, hay que volver a cargarlas.
N8N_ENCRYPTION_KEY=cambiar

GRAFANA_ADMIN_PASSWORD=cambiar
