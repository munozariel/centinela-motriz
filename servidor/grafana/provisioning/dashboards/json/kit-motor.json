          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval, NULL),\n  avg(rx_avg) AS \"rx\",\n  avg(ry_avg) AS \"ry\",\n  avg(rz_avg) AS \"rz (radial)\",\n  max(rz_max) AS \"rz máx\",\n  max(pico_max) AS \"Pico\"\nFROM minuto\nWHERE kit_id = '${kit}' AND $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
