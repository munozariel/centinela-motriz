      "type": "timeseries",
      "title": "Vibración general (RMS) por eje",
      "description": "Vibración general de cada eje y pico del eje radial, en g. rz es el eje radial (apunta al eje del motor). Se evalúa comparando con la línea base del motor sano.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
