      {
        "name": "Eventos del kit",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "monitor-pg"
        },
        "target": {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time,\n       tipo || coalesce(' (' || nullif(origen, '') || ')', '') || coalesce(': ' || detalle, '') AS text\nFROM evento\nWHERE kit_id = '${kit}' AND $__timeFilter(ts)"
        }
      }
    ]
  },
