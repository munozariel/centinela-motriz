    {
      "id": 5,
      "type": "stat",
      "title": "Corriente",
      "description": "Corriente promedio del último minuto, en % de la nominal de placa. Umbrales provisorios: 100% y 115%.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT m.i_avg / k.in_a * 100 AS \"% de In\" FROM minuto m JOIN kit k ON k.id = m.kit_id\nWHERE m.kit_id = '${kit}' ORDER BY m.ts DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
