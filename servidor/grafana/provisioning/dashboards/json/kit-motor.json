            "uid": "monitor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM now() - max(ts))::int AS \"Hace\" FROM minuto WHERE kit_id = '${kit}'"
